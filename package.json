{
  "name": "dudung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:scripts",
    "build:scripts": "esbuild src/worker/index.ts src/scripts/migrate.ts src/scripts/seed.ts --bundle --platform=node --format=esm --packages=external --outdir=dist --tsconfig=tsconfig.json --out-extension:.js=.mjs",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-storage": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@node-rs/argon2": "^2.2.2",
    "@tosspayments/tosspayments-sdk": "^2.10.0",
    "bullmq": "^5.81.5",
    "drizzle-orm": "0.45.4",
    "hono": "^4.13.17",
    "ioredis": "^5.11.1",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "~0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
