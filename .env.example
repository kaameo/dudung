# ── 운영 서버의 deploy/compose/.env 예시 ────────────────────────────────
# 실제 값은 서버 .env 와 GitHub Secrets 에만 둔다. 이 파일에는 예시만 커밋한다.

DOMAIN=dudung.duckdns.org
APP_URL=https://dudung.duckdns.org
APP_IMAGE=ghcr.io/kaameo/dudung:latest

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://dudung:change-me@127.0.0.1:5432/dudung
REDIS_URL=redis://127.0.0.1:6379/0

# ES256 키쌍: scripts/gen-keys.sh >> deploy/compose/.env
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# MediaMTX 훅 → 앱 내부 API 공유 비밀키 (openssl rand -hex 32)
INTERNAL_SECRET=change-me-to-a-long-random-string
MEDIAMTX_API_URL=http://127.0.0.1:9997
# webrtcAdditionalHosts 에 들어갈 서버 공인 IP (Oracle 1:1 NAT)
MEDIAMTX_PUBLIC_IP=203.0.113.10
RECORDINGS_DIR=/recordings

# Cloudflare R2 (S3 호환). 로컬 compose 는 SeaweedFS S3 를 쓴다
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=dudung
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 토스페이먼츠 결제위젯 테스트 키. 비워 두면 후원 UI 가 숨겨지고 나머지는 그대로 동작한다.
TOSS_CLIENT_KEY=test_gck_...
TOSS_SECRET_KEY=test_gsk_...

# 로그인 화면의 고정 계정 원클릭 로그인
TEST_LOGIN_ENABLED=true
LOG_LEVEL=info
